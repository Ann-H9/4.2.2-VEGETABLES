    "react-dom": "^18.3.1",
    "react-modal": "^3.16.3",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "gh-pages": "^5.0.0",
    "jsdom": "^24.0.0",
    "sass": "^1.69.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.8",
